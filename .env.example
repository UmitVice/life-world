# Public deployment URL, used for absolute metadata links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only after Google OAuth and NextAuth are configured
NEXT_PUBLIC_ENABLE_AUTH=false

# Persistence
MONGODB_URI=

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of administrator email addresses
ADMIN_EMAILS=
